---
import client from "../assets/client.json";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import {
  abs,
  graph,
  businessNode,
  websiteNode,
  webPageNode,
  breadcrumbNode,
  faqNode,
} from "../lib/schema.js";

const {
  // Page-specific title. The brand name is appended once, here — pages must not repeat it.
  title,
  description,
  // Optional: [{ name, path }] starting at Home. Renders BreadcrumbList structured data.
  breadcrumb,
  // Set on the page that renders the visible FAQ so FAQPage markup matches what's on screen.
  includeFaq = false,
  // Service pages render their own accordion and pass its items here.
  faqItems = null,
  schemaType = "WebPage",
  ogImage = "/images/og-default.jpg",
  // Error pages should stay out of the index but still pass link equity.
  noindex = false,
  // Extra JSON-LD nodes merged into this page's @graph (location pages pass a Service).
  extraSchema = [],
} = Astro.props;

const path = Astro.url.pathname;
const canonical = abs(path);
const fullTitle = `${title} | ${client.name}`;
const ogImageUrl = abs(ogImage);

// One connected @graph per page rather than several disconnected script tags.
const jsonLd = graph([
  businessNode(),
  websiteNode(),
  webPageNode({ path, title: fullTitle, description, type: schemaType }),
  breadcrumb ? breadcrumbNode(breadcrumb) : null,
  faqItems ? faqNode(faqItems, path) : includeFaq ? faqNode() : null,
  ...extraSchema,
]);
---

<!-- A fully fleshed-out <head>, dynamically changing based on client.json and the page front matter -->
<html lang="en">
  <head>
    <!-- Standard meta tags -->
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? "noindex, follow"
        : "index, follow, max-image-preview:large, max-snippet:-1"}
    />
    <meta name="author" content={client.name} />
    <meta name="theme-color" content="#4DA6A6" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- The card icons and graphics are served from this CDN; warm the connection early -->
    <link rel="preconnect" href="https://csimg.nyc3.cdn.digitaloceanspaces.com" crossorigin />

    <!-- Social Media Display -->
    <meta property="og:site_name" content={client.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${client.name} — ${client.tagline}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Bear River Bookkeeping" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Structured data (JSON-LD) describing the business, this page, and its content -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <!--Screen reader skip main nav-->
    <a class="skip" aria-label="skip to main content" href="#main">Click To Skip To Main Content</a>
    <Navbar />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
:global(:root) {
    /* Add these styles to your global stylesheet, which is used across all site pages. You only need to do this once. All elements in the library derive their variables and base styles from this central sheet, simplifying site-wide edits. For instance, if you want to modify how your h2's appear across the site, you just update it once in the global styles, and the changes apply everywhere. */
    --primary: #4DA6A6;
    --primaryLight: #A7D9D9;
    --secondary: #A3D9A5;
    --secondaryLight: #D5EEDD;
    --headerColor: #1A2B2E;
    --bodyTextColor: #3C4A4F;
    --bodyTextColorWhite: #FAFBFC;
    /* 13px - 16px */
    --topperFontSize: clamp(0.8125rem, 1.6vw, 1rem);
    /* 31px - 49px */
    --headerFontSize: clamp(1.9375rem, 3.9vw, 3.0625rem);
    --bodyFontSize: 1rem;
    /* 60px - 100px top and bottom */
    --sectionPadding: clamp(3.75rem, 7.82vw, 6.25rem) 1rem;
}

:global(body) {
    margin: 0;
    padding: 0;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

:global(.skip) {
    opacity: 0;
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1111111;
}

:global(*), :global(*:before), :global(*:after) {
    /* prevents padding from affecting height and width */
    box-sizing: border-box;
}

:global(.cs-topper) {
    font-size: var(--topperFontSize);
    line-height: 1.2em;
    text-transform: uppercase;
    text-align: inherit;
    letter-spacing: .1em;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 0.25rem;
    display: block;
}

:global(.cs-title) {
    font-size: var(--headerFontSize);
    font-weight: 900;
    line-height: 1.2em;
    text-align: inherit;
    max-width: 43.75rem;
    margin: 0 0 1rem 0;
    color: var(--headerColor);
    position: relative;
}

:global(.cs-text) {
    font-size: var(--bodyFontSize);
    line-height: 1.5em;
    text-align: inherit;
    width: 100%;
    max-width: 40.625rem;
    margin: 0;
    color: var(--bodyTextColor);
}                         
</style>
