---
import Layout from '../layouts/Layout.astro';
import AboutComponent from '../components/AboutComponent.astro'
import CTA from '../components/CTA.astro';
import riverImage from "../assets/river.jpg";
import Landing from '../components/Landing.astro';
---

<Layout
	title="About Us | Meet Rhonda Crockett"
	description="Meet Rhonda Crockett, owner and lead bookkeeper at Bear River Bookkeeping in Rathdrum, ID. 25+ years of experience, including 17 years in a CPA office."
	schemaType="AboutPage"
	breadcrumb={[{ name: "Home", path: "/" }, { name: "About Us", path: "/about/" }]}
	>
    <Landing title="About Us" image={riverImage}/>
    <AboutComponent CTAtext="Contact Us" CTAlink="/contact/" />
    <CTA />

</Layout>
