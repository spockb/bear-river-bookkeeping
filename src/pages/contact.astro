---
import ContactForm from "../components/ContactForm.astro";
import riverImage from "../assets/river.jpg";
import Landing from "../components/Landing.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Contact Us | Free Bookkeeping Consultation"
	description="Contact Bear River Bookkeeping in Rathdrum, ID for a free consultation or personalized quote. Serving North Idaho locally and clients nationwide."
	schemaType="ContactPage"
	breadcrumb={[{ name: "Home", path: "/" }, { name: "Contact Us", path: "/contact/" }]}
	>
    <Landing title="Contact Us" image={riverImage}/>
    <ContactForm />
</Layout>